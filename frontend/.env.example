# Frontend Environment Variables — скопируйте в frontend/.env (Vite).
# Правило: переменные Vite видны браузеру, поэтому НЕ кладите сюда секреты
# (ключ OpenRouter живёт только в backend/.env).

# URL backend для сборки (dev-прокси настроен в vite.config.ts, можно не указывать)
VITE_API_URL="http://localhost:3001"

# Google OAuth client id (необязательно; вход через Google отключён в UI, пока не задан)
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
