# Backend Environment Variables — скопируйте в backend/.env и заполните свои значения.
# backend/.env НЕ коммитится (см. .gitignore). Здесь только плейсхолдеры.

# --- База данных: (SQLite, файл создаётся автоматически рядом с backend/) ---
DATABASE_URL="file:./dev.db"

# --- Безопасность ---
# JWT_SECRET: случайная строка для подписи JWT-токенов, например сгенерируйте:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-64-hex-chars-random"

# ENCRYPTION_KEY: ровно 64 hex-символа (32 байта) для AES-256-GCM:
# шифрование пользовательских ключей OpenRouter:
#   openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# --- Сервер ---
PORT=3001
NODE_ENV="development"

# --- CORS: origin фронтенда (Vite dev-сервер) ---
CLIENT_ORIGIN="http://localhost:3000"

# --- Google OAuth (необязательно; без него вход через Google отключён в UI) ---
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# --- OpenRouter ---
# Системный ключ для FREE-пользователей: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your-system-key"
# Ключ управления (нужен, чтобы выдавать пользователям их личные ключи в PRO-режиме)
OPENROUTER_MANAGEMENT_KEY="sk-or-v1-your-management-key"

# --- Прокси (необязательно) ---
# Если прямые запросы к openrouter.ai блокируются провайдером (ошибка 403
# "Access denied by security policy"), задайте HTTP(S)-прокси:
# HTTPS_PROXY="http://127.0.0.1:8080"
# Скрипты dev/start уже выставляют NODE_USE_ENV_PROXY=1, чтобы Node
# подхватывал HTTP_PROXY/HTTPS_PROXY/NO_PROXY из окружения.
